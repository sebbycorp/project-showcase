{
  "manifest_version": 3,
  "name": "Agentgateway Chat",
  "version": "0.1.0",
  "description": "Chat with an LLM through an Agentgateway endpoint.",
  "action": {
    "default_title": "Agentgateway Chat",
    "default_popup": "popup.html"
  },
  "permissions": ["storage"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
